<?xml version="1.0" encoding="utf-8"?>
<!-- Halo suave alrededor del botón de encendido -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#14FF5722"
                android:endColor="#00FF5722"
                android:gradientRadius="124dp"
                android:startColor="#3DFF5722"
                android:type="radial" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>

</layer-list>
